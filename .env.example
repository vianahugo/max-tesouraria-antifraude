# Provedor do modelo de linguagem: offline, ollama, groq ou gemini.
# O modo offline nao exige chave e usa o motor deterministico.
LLM_PROVIDER=offline

# Modelo a ser usado. Deixe vazio para o padrao de cada provedor.
LLM_MODEL=

# Ollama local
OLLAMA_URL=http://localhost:11434

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Horizonte da projecao de caixa, em dias
HORIZONTE_DIAS=21

# Tempo limite das chamadas ao provedor, em segundos.
TIMEOUT_LLM=600
